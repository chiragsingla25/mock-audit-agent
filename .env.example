# Copy to .env and fill in by hand. Never commit .env.

# OpenRouter (set a US$10 credit limit on this key in the OpenRouter dashboard)
OPENROUTER_API_KEY=

# Models (proposal §5). Tester and skeptic must be different families.
TESTER_MODEL=qwen/qwen3.8-flash
TESTER_FALLBACK_MODEL=qwen/qwen3.5-flash-02-23
SKEPTIC_MODEL=deepseek/deepseek-v4-flash

# LangSmith tracing (free Developer plan)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mock-audit-agent

# Spend guard (US$)
RUN_SPEND_CAP_USD=1.00
PROJECT_SPEND_CAP_USD=9.50

# Runner
MAX_CONCURRENCY=4
CONTROL_TIMEOUT_S=180
